<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_4"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/signup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="50dp"
        android:gravity="center"
        android:text="Sign Up"
        android:textColor="@android:color/black"
        android:textSize="35sp"
        android:textStyle="bold" />

    <!-- Username -->
    <LinearLayout
        android:id="@+id/usernameRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/signup"
        android:layout_margin="10dp"
        android:background="#30ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Username icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_person_24" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="username"
            android:inputType="textPersonName" />
    </LinearLayout>

    <!-- Email -->
    <LinearLayout
        android:id="@+id/emailRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/usernameRow"
        android:layout_margin="10dp"
        android:background="#30ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Email icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_email_24" />

        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="email"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <!-- Password -->
    <LinearLayout
        android:id="@+id/passwordRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/emailRow"
        android:layout_margin="10dp"
        android:background="#30ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Password icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_vpn_key_24" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="password"
            android:inputType="textPassword" />
    </LinearLayout>

    <!-- Confirm password -->
    <LinearLayout
        android:id="@+id/userpasswordRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/passwordRow"
        android:layout_margin="10dp"
        android:background="#30ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Confirm password icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_vpn_key_24" />

        <EditText
            android:id="@+id/userpassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="confirm password"
            android:inputType="textPassword" />
    </LinearLayout>

    <Button
        android:id="@+id/loginbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/userpasswordRow"
        android:layout_centerHorizontal="true"
        android:layout_margin="20dp"
        android:backgroundTint="#6200EE"
        android:text="SUBMIT"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/socialicons"
        android:layout_centerHorizontal="true"
        android:text="or sign in with"
        android:textColor="@android:color/black"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/socialicons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="20dp"
            android:contentDescription="Social icon 1"
            android:scaleType="fitCenter"
            android:src="@drawable/img" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="20dp"
            android:contentDescription="Social icon 2"
            android:scaleType="fitCenter"
            android:src="@drawable/img_1" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="20dp"
            android:contentDescription="Social icon 3"
            android:scaleType="fitCenter"
            android:src="@drawable/img_2" />
    </LinearLayout>

</RelativeLayout>